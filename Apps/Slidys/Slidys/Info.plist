<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key></key>
	<string></string>
	<key>BAUsesAppleHosting</key>
	<true/>
	<key>BAAppGroupID</key>
	<string>group.yugo.sugiyama.iOSDC2024Slide</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<string>AppIcon</string>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string></string>
	</dict>
	<!-- 対戦モード(MultipeerConnectivity)用: ローカルネットワーク権限と Bonjour サービス宣言。
	     サービス種別 "slidys-duel" は MultipeerDuelTransport と一致させること。 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>近くのデバイスと対戦(デュエル)するために、ローカルネットワークを使用します。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_slidys-duel._tcp</string>
		<string>_slidys-duel._udp</string>
	</array>
</dict>
</plist>
